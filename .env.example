# SlotWake München — local secrets (never commit)

STARNBERG_TERMIN_ROOT=/Users/Inna/Projects/starnberg-termin

# Gmail (same App Password for SMTP send + IMAP signup ingest)
EMAIL=you@gmail.com
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
# IMAP_USER / IMAP_PASS default to SMTP_USER / SMTP_PASS

# Who to ping when a signup is ingested or an alert is sent
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_TARGET=@you   # if hermes CLI is installed
# SEND_WEBHOOK_URL=https://hooks.slack.com/services/...

# Concierge behaviour
CONCIERGE_URGENCY=14d
# CONCIERGE_URGENCY=all
CONCIERGE_HOUR_START=6
CONCIERGE_HOUR_END=19
# CONCIERGE_FORCE=1
# DRY_RUN=1
# STATS_AUTO_PUSH=1   # git commit + push stats.json after each run
